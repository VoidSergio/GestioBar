# Copia questo file in .env.local e riempi i valori.
# Li trovi su Supabase: Settings -> API   (vedi docs/06-SETUP-SUPABASE.md §3)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ATTENZIONE
# La chiave service_role NON va messa qui e non va mai usata dal browser:
# scavalca tutte le regole di sicurezza. Serve solo a script di manutenzione
# che lanci tu dal tuo computer.
